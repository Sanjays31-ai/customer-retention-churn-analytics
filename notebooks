      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Reproducible results\n",
        "np.random.seed(42)\n",
        "\n",
        "# Number of customers\n",
        "n = 10000\n",
        "\n",
        "# Customer IDs\n",
        "customer_ids = [\n",
        "    f\"CUST{str(i).zfill(5)}\"\n",
        "    for i in range(1, n + 1)\n",
        "]\n",
        "\n",
        "# Subscription plans\n",
        "plans = np.random.choice(\n",
        "    [\"Basic\", \"Standard\", \"Premium\"],\n",
        "    size=n,\n",
        "    p=[0.40, 0.40, 0.20]\n",
        ")\n",
        "\n",
        "# Monthly revenue based on plan\n",
        "plan_revenue = {\n",
        "    \"Basic\": 29,\n",
        "    \"Standard\": 59,\n",
        "    \"Premium\": 99\n",
        "}\n",
        "\n",
        "monthly_revenue = [\n",
        "    plan_revenue[plan] + np.random.randint(-5, 10)\n",
        "    for plan in plans\n",
        "]\n",
        "\n",
        "# Countries\n",
        "countries = np.random.choice(\n",
        "    [\"India\", \"USA\", \"UK\", \"Canada\", \"Australia\", \"Germany\"],\n",
        "    size=n,\n",
        "    p=[0.35, 0.25, 0.12, 0.10, 0.10, 0.08]\n",
        ")\n",
        "\n",
        "# Age groups\n",
        "age_groups = np.random.choice(\n",
        "    [\"18-25\", \"26-35\", \"36-45\", \"46-55\", \"56+\"],\n",
        "    size=n,\n",
        "    p=[0.15, 0.35, 0.30, 0.15, 0.05]\n",
        ")\n",
        "\n",
        "# Acquisition channels\n",
        "acquisition_channels = np.random.choice(\n",
        "    [\"Organic\", \"Paid Ads\", \"Referral\", \"Social Media\", \"Partner\"],\n",
        "    size=n,\n",
        "    p=[0.30, 0.25, 0.20, 0.15, 0.10]\n",
        ")\n",
        "\n",
        "# Contract types\n",
        "contract_types = np.random.choice(\n",
        "    [\"Monthly\", \"Annual\"],\n",
        "    size=n,\n",
        "    p=[0.65, 0.35]\n",
        ")\n",
        "\n",
        "# Customer tenure\n",
        "tenure_months = np.random.randint(\n",
        "    1, 61, size=n\n",
        ")\n",
        "\n",
        "# Support tickets\n",
        "support_tickets = np.random.poisson(\n",
        "    lam=3,\n",
        "    size=n\n",
        ")\n",
        "\n",
        "# Login frequency\n",
        "login_frequency = np.random.poisson(\n",
        "    lam=12,\n",
        "    size=n\n",
        ")\n",
        "\n",
        "# Payment failures\n",
        "payment_failures = np.random.poisson(\n",
        "    lam=0.5,\n",
        "    size=n\n",
        ")\n",
        "\n",
        "# Signup date\n",
        "signup_date = (\n",
        "    pd.to_datetime(\"2026-08-01\")\n",
        "    - pd.to_timedelta(tenure_months * 30, unit=\"D\")\n",
        ")\n",
        "\n",
        "# Last login date\n",
        "last_login_days_ago = np.random.randint(\n",
        "    0, 91, size=n\n",
        ")\n",
        "\n",
        "last_login_date = (\n",
        "    pd.to_datetime(\"2026-08-31\")\n",
        "    - pd.to_timedelta(last_login_days_ago, unit=\"D\")\n",
        ")\n",
        "\n",
        "# -------------------------------\n",
        "# Create churn probability\n",
        "# -------------------------------\n",
        "\n",
        "churn_probability = (\n",
        "    0.08\n",
        "    + (login_frequency < 5) * 0.15\n",
        "    + (support_tickets > 6) * 0.10\n",
        "    + (payment_failures >= 2) * 0.15\n",
        "    + (contract_types == \"Monthly\") * 0.08\n",
        "    + (tenure_months < 6) * 0.05\n",
        ")\n",
        "\n",
        "# Keep probability between 0 and 80%\n",
        "churn_probability = np.clip(\n",
        "    churn_probability,\n",
        "    0,\n",
        "    0.80\n",
        ")\n",
        "\n",
        "# Generate churn outcome\n",
        "churned = np.random.binomial(\n",
        "    1,\n",
        "    churn_probability\n",
        ")\n",
        "\n",
        "# -------------------------------\n",
        "# Create churn reasons\n",
        "# -------------------------------\n",
        "\n",
        "churn_reasons = []\n",
        "\n",
        "for i in range(n):\n",
        "\n",
        "    if churned[i] == 0:\n",
        "        churn_reasons.append(\"Not Churned\")\n",
        "\n",
        "    elif payment_failures[i] >= 2:\n",
        "        churn_reasons.append(\"Payment Issues\")\n",
        "\n",
        "    elif login_frequency[i] < 5:\n",
        "        churn_reasons.append(\"Low Engagement\")\n",
        "\n",
        "    elif support_tickets[i] > 6:\n",
        "        churn_reasons.append(\"Poor Support Experience\")\n",
        "\n",
        "    elif plans[i] == \"Basic\":\n",
        "        churn_reasons.append(\"Pricing\")\n",
        "\n",
        "    else:\n",
        "        churn_reasons.append(\"Competitor\")\n",
        "\n",
        "# -------------------------------\n",
        "# Create final DataFrame\n",
        "# -------------------------------\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"customer_id\": customer_ids,\n",
        "    \"signup_date\": signup_date,\n",
        "    \"plan\": plans,\n",
        "    \"monthly_revenue\": monthly_revenue,\n",
        "    \"tenure_months\": tenure_months,\n",
        "    \"country\": countries,\n",
        "    \"age_group\": age_groups,\n",
        "    \"acquisition_channel\": acquisition_channels,\n",
        "    \"support_tickets\": support_tickets,\n",
        "    \"login_frequency\": login_frequency,\n",
        "    \"payment_failures\": payment_failures,\n",
        "    \"last_login_date\": last_login_date,\n",
        "    \"contract_type\": contract_types,\n",
        "    \"churned\": churned,\n",
        "    \"churn_reason\": churn_reasons\n",
        "})\n",
        "\n",
        "print(\"Dataset created successfully!\")\n",
        "print(\"Rows:\", len(df))\n",
        "print(\"Columns:\", len(df.columns))"
      ],
